#! /usr/bin/bash

shopt -s extglob
shopt -s nullglob

######### ### script state ### #########
declare -a configFiles
#The "output"s from a config file
declare -a bupDirs

#The "input"s from a config file, and the array of those that exist
declare -a configInputs
declare -a inputsAll
#The pairs of "inputCommand/inputResult" from a config file
declare -a configCommands
declare -a inputResults
#Filenames generated by the "inputCommand"s that actually exist
declare -a generatedInputsAll
#How many versions of a backup to keep
declare -i keepVersions

declare -i inputCnt # number of inputs that were found and participated in backing up
declare -i nonexistentCnt # number of inputs that weren't found
declare -i outputCnt # total number of copies (with checksums) made
declare -i deletedCnt

######### ### ### #### ### ### #########

#Read a single config file and fill the arrays of inputs&outputs
#$1 = config file
function readConfig() {
   echo "Processing config file: $1"
   local state="default" # default | inputCommand
   bupDirs=()
   configInputs=()
   configCommands=()
   inputResults=()
   generatedResults=()
   
   while IFS=" = " read k v; do
      if [[ "$v" == "" ]]; then
         continue
      fi
      
      if [[ $state == "inputCommand" ]]; then
         if [[ "$k" == "inputResult" ]]; then
            eval local vv="$v" #expand the ~ or other env vars in the string
            inputResults+=("$vv")
            state="default"
         else
            echo 
         fi
      else
         case $k in
         "output")
            eval local vv="$v"
            bupDirs+=("$vv")
            ;;
         "inputCommand")
            configCommands+=("$v")
            state="inputCommand"
            ;;
         "input")
            eval local vv="$v"
            if [[ -f "$vv" ]]; then
               configInputs+=("$vv")
               inputsAll+=("$vv")
               ((inputCnt++))
            else
               echo "Input doesn't exist!"
               echo "||$vv||"
            fi
            ;;
         "keepVersions")
            (( keepVersions = (v > 0) ? v : 1 ))
            ;;
         *)
            echo "Unknown key '$k'."
            echo "Expected one of: output, input, inputCommand,"
            echo "inputResult (only after inputCommand!), keepVersions."
            exit 1
            ;;
         esac
      fi
   done < "$1"
   
   if (( "${#configInputs[@]}" + "${#configCommands[@]}" == 0)) then
      echo "Empty inputs! Nothing to backup!"
      exit 1
   fi
   if (("${#configCommands[@]}" != "${#inputResults[@]}")) then
      echo "The number of commands should match number of outputs" #Should be unreachable
      exit 1
   fi
   
   if [[ $state == "inputCommand" ]]; then
      echo "Expected 'inputResult = ' after 'inputCommand'!"
      exit 1 
   fi
}

#Get all the existing backup ids of a file, and calculate the maximum among them
#$1 = short file name without the ".123.bak" suffix. $2 = output dir. 
#$3 = OUT array of existing ids, $4 = OUT max backup id
function getAllAndLatestVersions() {
   local -n existing=$3
   local -n maxId=$4
   
   local existingBackups=( $2/$1.*.bak )
   
   ((maxId = -1))
   
   for fn in "${existingBackups[@]}"; do
      if [[ "$fn" =~ $2/$1.([0-9]+).bak ]]; then
         local bId=$(( "${BASH_REMATCH[1]}" ))
         existing+=($bId)
         
         if (( bId > maxId )) then  
            ((maxId = bId))
         fi
      fi
   done
}

#Check if the new backup is different from the latest existing backup.
#$1 = existing backup. $2 = new backup. $3 = OUT 1 iff they differ
function checkIfFilesDiffer() {
   declare -n out=$3
   local szOld=$(stat -c %s $1)
   local szNew=$(stat -c %s $2)
   
   if (( szOld != szNew )) then
      ((out = 1))
      return 0
   elif ! cmp -s $1 $2; then
      ((out = 1))
      return 0
   fi
   ((out = 0))
}

#Check how many versions of a backup exist and if it's more than keepVersions, delete extra ones
#Sort the versions ascending and delete the lowest versions.
#$1 = existingVersions array. $2 inpShort. $3 output
function deleteExtraVersions() {
   local -n existVers=$1
   if (( "${#existVers[@]}" <= $keepVersions )) then
      return 0
   fi
   declare -a sortedVersions  
   readarray -t sortedVersions < <(printf '%s\n' "${existVers[@]}" | sort -n)
   
   local j
   for (( j="${#existVers[@]}" - $keepVersions - 1; j>=0; j-- )); do
      /usr/bin/rm $3/$2.${sortedVersions[j]}.bak
      /usr/bin/rm $3/$2.${sortedVersions[j]}.sha256
      ((deletedCnt++))
   done
}

#Create a new backup. Precondition: $1 must exist and be a file.
#$1 inpResult. $3 output
function backAFileUp() {
   local input="$1"
   local inpShort="${input##*/}"
   declare -i maxBId
   declare -a existingVersions
   getAllAndLatestVersions "$inpShort" $2 existingVersions maxBId
   local newId=$(( maxBId + 1 ))
   
   if (( maxBId >= 0)) then
      declare -i filesDiffer
      checkIfFilesDiffer $1 "$2/$inpShort.$maxBId.bak" filesDiffer
      if (( filesDiffer == 0)) then
         deleteExtraVersions existingVersions $inpShort $2
         return 0
      fi
   fi
   
   #Actually copy the file to output dir and create&validate its checksum
   local newName="$2/$inpShort.$newId.bak"
   local newChecksumName="$2/$inpShort.$newId.sha256"
   /usr/bin/cp $1 $newName
   existingVersions+=( $newId )
   ((outputCnt++))
   
   origChecksumAndFname="$(sha256sum $1)"
   newChecksumAndFname="$(sha256sum $newName)"
   origChecksum="${origChecksumAndFname:0:64}"
   newChecksum="${newChecksumAndFname:0:64}"
   if [[ "$newChecksum" != "$origChecksum" ]]; then
      echo "Checksum error when copying file "
      echo "||$1||"
      echo "to ||$2||"
      return 1
   fi
   echo "$newChecksum" > "$newChecksumName"
   
   deleteExtraVersions existingVersions $inpShort $2
}

#Make all the backups configured in all the files in ~/.config/closha
function makeBackups() {
   keepVersions=$((3))
   
   readarray -t configFiles < <(ls -A $HOME/.config/closha 2>/dev/null)
   
   if [[ ${#configFiles[@]} == 0 ]]; then
      echo "No config files in $HOME/.config/closha, nothing to do!"
      exit 1
   fi
   
   echo -e "\e[92mClosha is starting to clone files\e[0m"
   echo ""
   
   for cFile in "${configFiles[@]}"; do
      readConfig "$HOME/.config/closha/$cFile"
      
      #Ordinary inputs
      declare -i i
      for ((i=0; i<"${#configInputs[@]}"; i++)); do
         local input="${configInputs[i]}"
         if [[ -f "$input" ]]; then
            for output in "${bupDirs[@]}"; do
               backAFileUp $input $inpShort $output
            done
         else 
            echo "Expected a file to back up but can't find it!"
            echo "||$input||"
         fi
      done
      
      #Inputs generated from commands. They will be cleaned up in deleteGeneratedInputs()
      for ((i=0; i< "${#configCommands[@]}"; i++)) do
         local comm="${configCommands[i]}"
         local inpRes="${inputResults[i]}"
         
         eval "$comm" #Run user command to (hopefully) create the inpRes file 
         
         if [[ -f "$inpRes" ]]; then
            generatedInputsAll+=("$inpRes")
            ((inputCnt++))
            for output in "${bupDirs[@]}"; do
               backAFileUp $inpRes $output
            done
         else 
            echo "Expected the command to produce a file to back up, but none was found!"
            echo "||$inpRes||"
         fi
      done
   done
}

#If the restored backup is an archive, unpack it to a subdir and delete the archive
#$1 = backup filename
function maybeUnpack() {
   local bup="$1"
   local extractTo=""
   
   if [[ "$bup" =~ .*\.tar\.gz || "$bup" =~ .*\.tar\.xz ]]; then
      extractTo="${bup:0:${#bup} - 7}"
   elif [[ "$bup" =~ .*\.tar\.zst ]]; then
      extractTo="${bup:0:${#bup} - 8}"
   elif [[ "$bup" =~ .*\.gz || "$bup" =~ .*\.xz ]]; then
      extractTo="${bup:0:${#bup} - 3}"
   elif [[ "$bup" =~ .*\.zst ]]; then
      extractTo="${bup:0:${#bup} - 4}"
   fi
   
   if [[ "$extractTo" != "" ]]; then
      mkdir "$extractTo"
      /usr/bin/tar -x -f "$bup" -C "$extractTo"
      echo "Extracted archive to $extractTo"
   fi
}

#Restore a single backup into the same dir. Unpack it into a subdir if it's a tarball
#$1 = backup file name. $2 = restoration path
function restoreFromBackup() {
   local bup=$(realpath "$1")
   if ! [[ -f $bup ]]; then
      echo "File doesn't exist or is a directory!"
      exit 1
   elif [[ "$bup" =~ .*\.([0-9]+).bak ]]; then
      local bId=$(( "${BASH_REMATCH[1]}" ))
      local checksumFname="${bup%.bak}.sha256"
      
      if ! [[ -f "$checksumFname" ]]; then
         echo "Checksum file doesn't exist, cannot validate the backup!"
         exit 1
      fi
      
      local restoredChecksumAndFname="$(sha256sum $1)"
      local restoredChecksum="${restoredChecksumAndFname:0:64}"
      local readChecksum=$(<$checksumFname)
      if [[ "$restoredChecksum" != "$readChecksum" ]]; then
         echo "Bitrot detected in backup! Current checksum is"
         echo "$restoredChecksum"
         echo "but the one written upon creation is"
         echo "$readChecksum"
         exit 1
      fi
      
      local restoredFname="${bup%.$bId.bak}"
      /usr/bin/cp "$bup" "$restoredFname"
      echo "Restored the backup to $restoredFname"
      
      maybeUnpack "$restoredFname"
   else
      echo "The file name doesn't check out. It should end with a number like '.123.bak'"
      exit 1
   fi
}

#Backup a file to a single mounted USB stick
#$1 = mount path of the stick.
function copyToStick() {
   if [[ -d "$1/closha" ]]; then
      for input in "${inputsAll[@]}"; do
         backAFileUp "$input" "$1/closha"
      done
      for input in "${generatedInputsAll[@]}"; do
         backAFileUp "$input" "$1/closha"
      done
   fi
}

#Backup all data to any USB sticks (mounted or unmounted) that contain the dir "closha" at toplevel
function backupToSticks() {
   declare -a mounted
   readarray -t mounted < <(lsblk -J |  jq -r '[.blockdevices.[] | select (.rm == true)] | 
      select(.[].children[0].mountpoints | length > 0) | map(.children[0].mountpoints[0] ).[]')
      
   for m in "${mounted[@]}"; do
      echo "Backin' up to $m" 
      copyToStick "$m"
   done
   
   declare -a unmounted
   readarray -t unmounted < <(lsblk -J | jq -r '[.blockdevices.[] | select (.rm == true)] 
      | select(.[].children[0].mountpoints | length == 0) | map("/dev/" + .children[0].name).[]')
      
   for um in "${unmounted[@]}"; do
      echo "Backin' up to unmounted $um" 
      local stickPath="/mnt/closhaStick"
      doas /usr/bin/mount -o noatime,sync --mkdir "$um" "$stickPath"
      copyToStick $stickPath
      doas /usr/bin/umount "$stickPath"
   done
}

function displayHelp() {
   echo "----------------------------------------------------------------------"
   echo "                           C L O S H A"
   echo "----------------------------------------------------------------------"
   echo ""
   echo "Usage:"
   echo "1. create one or more config files in ~/.config/closha"
   echo "2. Run 'closha' to backup all you've listed in the files"
   echo "3. Run 'closha myBackup.12.bak' to restore a backup"
   echo ""
   echo "As for what a config file should look like, it goes like this:"
   echo ""
   echo "output = ~/backups"
   echo "input = ~/path/to/file.txt"
   echo "inputCommand = git -c core.abbrev=no -C ~/path/to/repo archive \\"
   echo "    --format tar 1.0.0  > ~/path/to/tarball.tar.xz"
   echo "inputResult = ~/path/to/tarball.tar.xz"
   echo "keepVersions = 4"
   echo ""
   echo "'input' is for just files to copy,"
   echo "'inputCommand' + 'inputResult' pairs are for commands that produce "
   echo "files to copy (and those intermediate 'inputResult' files are deleted"
   echo "after backup)"
   echo "'keepVersions' = how many latest versions to keep around (default = 3)"
   echo "----------------------------------------------------------------------"
   echo ""
}

#Delete intermediate files generated by user commands after they've been backed up
function deleteGeneratedInputs() {
   for generated in "${generatedInputsAll[@]}"; do
      /usr/bin/rm "$generated"
   done
}

#Main (entrypoint)
if [[ "$1" == "" ]]; then
   makeBackups
   backupToSticks
   deleteGeneratedInputs
   echo ""
   
   if (( inputCnt > 0 )) then
      echo -e "Found $inputCnt inputs"
   fi
   if (( outputCnt > 0 )) then
      echo -e "Made $outputCnt file copies"
   fi
   if (( deletedCnt > 0 )) then
      echo -e "Deleted $deletedCnt old versions"
   fi
   if (( nonexistentCnt > 0 )) then
      echo -e "ERROR: $nonexistentCnt inputs were not found!"
   fi
   echo -e "\e[92mClosha finished cloning files\e[0m"
elif [[ "$1" == "-h" || "$1" == "--help" ]]; then
   displayHelp
elif [[ "$1" == "-v" || "$1" == "--verbose" ]]; then
   echo "closha version 0.9.0"
   echo "(file backup utility, run closha -h to see how to use it)"
else
   restorePath="$HOME/.local/share/closha/"
   mkdir -p "$restorePath"
   restoreFromBackup $1 $restorePath
fi

