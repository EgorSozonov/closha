# Maintainer: Egor Sozonov
# Contributor: Egor Sozonov

pkgname=closha
pkgver=_
pkgrel=1
pkgdesc='Local file backup tool that also handles arrays of USB sticks' 
arch=(x86_64)
url='https://github.com/EgorSozonov/closha'
license=(BSD-3-Clause)
depends=(coreutils tar jq util-linux opendoas) 
makedepends=(git)
source=(git+https://github.com/EgorSozonov/$pkgname#tag=$pkgver)
options=(!debug !strip)
sha256sums=('SKIP')
changelog="changelog.txt"

check() {
   local exeVersion="$(closha -v | grep -oE '[0-9]+')"
   if [[ "$exeVersion" != "$pkgver" ]]; then
      error "The program has version $exeVersion but the package's version = $pkgver"
      exit 1
   fi
}

package() {
   make install DESTDIR=$pkgdir PREFIX=/usr
}

